FROM registry.cn-hangzhou.aliyuncs.com/google_containers/python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y \
  build-essential \
  default-libmysqlclient-dev \
  pkg-config \
  netcat-traditional \
  && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .

RUN pip install -i https://pypi.tuna.tsinghua.edu.cn/simple --no-cache-dir -r requirements.txt || \
  (echo "Retrying in 5 seconds..." && sleep 5 && pip install -i https://pypi.tuna.tsinghua.edu.cn/simple --no-cache-dir -r requirements.txt) || \
  (echo "Retrying in 10 seconds..." && sleep 10 && pip install -i https://pypi.tuna.tsinghua.edu.cn/simple --no-cache-dir -r requirements.txt)

COPY entrypoint.sh .
RUN chmod +x entrypoint.sh

COPY . .

RUN mkdir -p uploads

ENV PYTHONPATH=/app
ENV ENVIRONMENT=development

ENTRYPOINT ["./entrypoint.sh"]